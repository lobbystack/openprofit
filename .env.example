# sqlite file for self-host and local dev
DATABASE_URL=file:./data/openprofit.db
# DATABASE_AUTH_TOKEN=

# 32 random bytes, base64. Encrypts provider credentials.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=

# cloud | selfhost
APP_MODE=selfhost

# Public URL of this instance
APP_URL=http://localhost:3000

# Optional sign-in providers. Magic links print to the server log when
# RESEND_API_KEY is unset.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=
