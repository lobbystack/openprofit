# PGlite (embedded Postgres) directory for self-host and local dev, or a postgres:// URL
DATABASE_URL=./data/openprofit

# 32 random bytes, base64. Encrypts provider credentials.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=

# cloud | selfhost
APP_MODE=selfhost

# Public URL of this instance
APP_URL=http://localhost:3000
# Behind a reverse proxy (nginx, Caddy, Traefik): how many sit in front, usually 1.
# TRUST_PROXY=1

# Serve the read-only demo with sample numbers at /demo. On by default with
# APP_MODE=cloud.
# DEMO=on

# Optional sign-in providers. Magic links print to the server log when
# RESEND_API_KEY is unset.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=

# Optional SMS alerts through Twilio. The SMS channel shows on the Alerts
# page once all three are set. TWILIO_FROM is a number in E.164 format
# (+14155550100) or a Messaging Service SID (MG...).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Hosted mode only (APP_MODE=cloud): Polar organization token, the two
# product ids, and the webhook secret for /api/polar/webhook.
# POLAR_ACCESS_TOKEN=
# POLAR_PRODUCT_INDIE=
# POLAR_PRODUCT_PRO=
# POLAR_WEBHOOK_SECRET=
# POLAR_API_URL=https://sandbox-api.polar.sh

# Optional PostHog analytics, replay, error tracking and server logs. Nothing
# is sent while POSTHOG_KEY is unset.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PROXY=https://e.example.com
